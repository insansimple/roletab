{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability eksklusif hanya untuk UI Shell RoleTab (child webviews external zero-IPC)",
  "webviews": ["ui-shell", "profile-panel", "download-panel"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "core:webview:allow-set-webview-focus",
    "updater:default"
  ]
}
