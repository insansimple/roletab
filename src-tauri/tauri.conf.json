{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoleTab",
  "version": "1.1.2",
  "identifier": "com.roletab.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' https: http: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "publisher": "RoleTab Contributors",
    "copyright": "Copyright (c) 2026 RoleTab",
    "shortDescription": "Multi-role isolated desktop browser for QA & developers",
    "longDescription": "Desktop tabbed browser built on WebView2 where every tab runs in an isolated session profile or ephemeral sandbox.",
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQzhFMjlFRTVDNUFDOTYKUldTV3JNWGxudUxJT3BsdGxJbVcxNDlQMzJxU2s3OGFoSlJHQkI3N0huQ0piSlBNazUwaFozZXoK",
      "endpoints": [
        "https://github.com/insansimple/roletab/releases/latest/download/latest.json"
      ]
    }
  }
}
